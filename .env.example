# ImageCare ERP - Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to source control.

# Supabase - get from Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# App
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=ImageCare ERP

# NEVER add VITE_SUPABASE_SERVICE_ROLE here.
# The service_role key bypasses RLS and must never be in the frontend.
